// This adds an open-cycle radiator using hydrogen 

@PART:HAS[@RESOURCE[LqdHydrogen]]:FOR[SystemHeatExpansion]
{
    %MODULE[ModuleSystemHeat]
    {
        %name = ModuleSystemHeat
        %volume = 100
    }

    MODULE
    {
        name = ModuleSHXOpenCycleRadiator
        moduleID = open-cycle-radiator

        coolantName = LqdHydrogen

        // What temperature does the coolant start off at?
        // 15 K
        coolantTemperature = 15

        // How much energy does it take to vaporize the coolant. This is free
        // flux removed from the heat loop no matter what the exhaust temp is.
        // If your resource is supposed to be a gas already then you can leave
        // this out and it will default to 0.
        //
        // 0.904 kJ/mol * 495 mol/kg = 447.41 kJ/kg -> 447480 kJ/t
        coolantVaporizationCost = 447480
        // 1kg/s
        coolantMassFlow = 0.001

        // You should generally set this to be above the boiling point of
        // whatever coolant you are using.
        minOperatingTemperature = 50

        // Above this temp the radiator will stop working. Defaults to 4000.
        maxOperatingTemperature = 4000

        // Most substances don't have one specific heat capacity at all
        // temperatures, it will vary. This allows you to specify that.
        //
        // Note that only the specific heat capacity at the current temperature
        // is used. If you want to be fully accurate you will need to calculate
        // the average SHC to heat up the coolant to that temperature and put
        // that value in the curve.
        coolantSpecificHeatCapacityCurve
        {
            // 15.25 kJ/kg/K -> 15250 kJ/t/K
            key = 0    15250
            key = 1150 15250
            key = 1500 16000
            key = 6000 21000
        }

        // The efficiency curve controls how effectively the radiator transfers
        // heat to the coolant. A value of 0 means that no heat is transferred
        // while a value of 1 means that the coolant is emitted at exactly the
        // temperature of the SystemHeat loop.
        //
        // The default is to have efficiency be 1 for the whole temperature range.
        heatTransferEfficiencyCurve
        {
            key = 0 1
        }

        // In order to scale coolant usage to only that needed to actually cool
        // the loop, this module scales the amount of coolant used in a temperature
        // range above the nominal temperature. This field controls how wide that
        // range is.
        //
        // Generally the default value of 25 should be fine.
        flowScaleRange = 25

        // If this is true then all the numbers involving mass above are now in
        // terms of resource units. This happens automatically if the resource's
        // density is 0, but this option lets you force it even for resources
        // with non-zero density.
        ignoreCoolantDensity = false
    }
}